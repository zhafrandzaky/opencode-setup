# =============================================================================
# OpenCode global environment variables
# =============================================================================
# Copy this file to ~/.config/opencode/.env and fill in the values you need.
#
# HOW IT IS LOADED
#   OpenCode itself does NOT auto-read this file. A small plugin does:
#   ~/.config/opencode/plugins/dotenv.ts
#
#   - On every OpenCode start the plugin parses this .env file and registers
#     each variable into the process environment of OpenCode and of every
#     shell/tool subprocess it spawns (Strix, browser-use, Playwright, MCP
#     servers, ECC scripts, ...).
#   - Values are applied ONLY if the variable is not already set in your real
#     environment, so your shell/daemon-managed values always win.
#   - Supported syntax: `KEY=value`, `KEY=value # comment`, `export KEY=value`,
#     single/double quoted values, blank lines, `#` comment lines.
#   - To disable a variable without deleting it, comment the line with `#`.
#
# Anything you put here is a SECRET if it is a key/token. Never commit this
# file — .gitignore in this directory already blocks `.env` and `.env.*`.
# =============================================================================

# -----------------------------------------------------------------------------
# Strix (AI security audit) — see ~/.local/share/uv/tools/strix-agent
# Used by `strix --target <dir|url>`. Requires a Docker daemon running.
# -----------------------------------------------------------------------------
# REQUIRED — which LLM model powers Strix (OpenAI-compatible chat format).
# Examples:
#   openrouter/z-ai/glm-5.3
#   anthropic/claude-opus-4-7
#   openai/gpt-5
#   ollama/qwen3:32b
STRIX_LLM=

# EFFECTIVELY REQUIRED — API key for the STRIX_LLM provider.
# Fallback alias: OPENAI_API_KEY is accepted when LLM_API_KEY is unset.
LLM_API_KEY=

# OPTIONAL — custom base URL for the LLM provider (OpenAI-compatible).
# Aliases also accepted: OPENAI_API_BASE, OPENAI_BASE_URL, LITELLM_BASE_URL,
# OLLAMA_API_BASE.
# LLM_API_BASE=https://api.openai.com/v1

# OPTIONAL — web-search provider keys used by Strix during scans.
# EXA_API_KEY=
# PERPLEXITY_API_KEY=

# OPTIONAL — Sandbox resource limits (defaults are CPU 2, mem 2G, etc.).
# STRIX_SANDBOX_CPUS=2
# STRIX_SANDBOX_MEM_LIMIT=2g
# STRIX_SANDBOX_PIDS_LIMIT=256
# STRIX_SANDBOX_SHM_SIZE=512m

# OPTIONAL — disable the "new version available" nag / enable debug logging.
# STRIX_NO_UPDATE_CHECK=1
# STRIX_DEBUG=1

# OPTIONAL — managed Strix Cloud (only if you use the hosted service).
# STRIX_API_TOKEN=
# STRIX_APP_URL=
# STRIX_CAIDO_URL=
# STRIX_WORKSPACE_ID=

# -----------------------------------------------------------------------------
# browser-use / bu (browser automation) — see browser-harness 0.1.13 docs
# Local automation needs no key; only the opt-in cloud auth features do.
# -----------------------------------------------------------------------------
# OPTIONAL — cloud authentication token for browser-use Cloud.
# BROWSER_USE_API_KEY=

# OPTIONAL — opt-in to auto-spawning cloud browsers (default: off).
# BU_AUTOSPAWN=1

# OPTIONAL — telemetry/model hints (defaults: provider openai, model gpt-*).
# BROWSER_USE_MODEL_PROVIDER=openai
# BROWSER_USE_AGENT_MODEL=gpt-4o

# OPTIONAL — home dir / OAuth client used by the browser harness auth flow.
# BROWSER_HARNESS_HOME=
# BROWSER_HARNESS_OAUTH_CLIENT_ID=

# -----------------------------------------------------------------------------
# LLM provider keys
# Useful if ECC skills/commands or other tools call LLM APIs directly, and as
# a sensible default for LLM_API_KEY-style integrations that accept
# OPENAI_API_KEY / ANTHROPIC_API_KEY.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# ECC plugin hooks (plugins/ecc-hooks.ts)
# -----------------------------------------------------------------------------
# OPTIONAL — hook severity profile. Valid: minimal | standard | strict.
# This config was installed with --no-hooks, so hooks only take effect if you
# opt-in by setting a profile here.
# ECC_HOOK_PROFILE=standard

# OPTIONAL — comma-separated list of hook IDs to disable (see ecc-hooks.ts).
# ECC_DISABLED_HOOKS=format-code.after,tsc-check.after

# -----------------------------------------------------------------------------
# MCP servers (mcp-configs/mcp-servers.json)
# Only needed for the servers you actually enable in that file.
# -----------------------------------------------------------------------------
# GitHub ops server
# GITHUB_PERSONAL_ACCESS_TOKEN=

# Jira server
# JIRA_URL=https://your.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=

# Firecrawl (web scraping / search)
# FIRECRAWL_API_KEY=

# Itô compute (GPU rentals)
# ITO_API_KEY=
# ITO_AUTH_MODE=legacy

# -----------------------------------------------------------------------------
# ECC scripts (scripts/*.js)
# -----------------------------------------------------------------------------
# OPTIONAL — X/twitter (claw) helper: which model/session/skills to pass.
# CLAW_MODEL=
# CLAW_SESSION=
# CLAW_SKILLS=

# -----------------------------------------------------------------------------
# Settings this machine already handles elsewhere (leave unset here)
# -----------------------------------------------------------------------------
# - LLM keys for the OpenCode model itself are managed via `opencode auth`
#   (store in the `opencode_auth.json` credentials store, not here).
# - PATH-related globals (fnm, ~/.local/bin for browser-use/strix) come from
#   your shell profile; do NOT redefine them in this file.